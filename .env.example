# Neo4j
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=change_me_strong_password

# Encryption (generate with: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))")
ENCRYPTION_KEY=your_32_byte_base64_key_here
SALT=your_salt_base64_here

# NextAuth
NEXTAUTH_URL=https://publix.dk
NEXTAUTH_SECRET=your_nextauth_secret_here

# Email (Resend - resend.com)
RESEND_API_KEY=re_your_api_key_here
RESEND_FROM_EMAIL=noreply@publix.dk

# IntelX (optional, paid)
INTELX_API_KEY=your_intelx_api_key_here
INTELX_API_URL=https://2.intelx.io

# HIBP Pro (optional, paid tier)
HIBP_API_KEY=your_hibp_api_key_here

# Dehashed (optional, paid tier)
DEHASHED_USERNAME=your_email@example.com
DEHASHED_API_KEY=your_dehashed_api_key_here

# Stripe (payments)
STRIPE_SECRET_KEY=sk_test_your_key_here
STRIPE_WEBHOOK_SECRET=whsec_your_webhook_secret_here
STRIPE_PAID_PRICE_ID=price_your_price_id_here
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_your_publishable_key_here

# Sentry (error monitoring, optional)
SENTRY_DSN=https://your_key@sentry.io/your_project_id

# Logging
LOG_LEVEL=info
